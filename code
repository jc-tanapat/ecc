function getMasterCombinedCalendarData(startDateStr, endDateStr) {
  var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  var syncSheet = ss.getSheetByName(DB_SYNC_NAME);
  var editSheet = ss.getSheetByName(DB_EDIT_NAME);
  if (!syncSheet || !editSheet) return [];

  var syncData = syncSheet.getDataRange().getDisplayValues();
  var editData = editSheet.getDataRange().getDisplayValues();

  var editsMap = {};
  for (var j = 1; j < editData.length; j++) {
    if (editData[j][0]) {
      editsMap[editData[j][0]] = { uid: editData[j][1], status: editData[j][2], notes: editData[j][3], officer: editData[j][4], eddType: editData[j][5] };
    }
  }

  var eventsList = [];
  var monthsMap = {'Jan':'01','Feb':'02','Mar':'03','Apr':'04','May':'05','Jun':'06','Jul':'07','Aug':'08','Sep':'09','Oct':'10','Nov':'11','Dec':'12'};
  var startNum = startDateStr ? parseInt(startDateStr.replace(/-/g, ""), 10) : null;
  var endNum   = endDateStr   ? parseInt(endDateStr.replace(/-/g, ""),   10) : startNum;

  for (var i = 1; i < syncData.length; i++) {
    var row = syncData[i];
    var id = row[0];
    if (!id) continue;

    var customerEmail = String(row[2] || "").trim();
    var eData = editsMap[id] || {};
    var status = eData.status || "Need check";
    
    if (status === "Deleted") continue; 

    var dateClean = String(row[4]).replace(/'/g, "");
    var parts = dateClean.split('-');
    if (parts.length === 3) {
      var rowNum = parseInt(parts[2] + (monthsMap[parts[1]] || "01") + parts[0].padStart(2,'0'), 10);
      if (startNum && (rowNum < startNum || rowNum > endNum)) continue;
    }

    eventsList.push({
      id: id, title: row[1], uid: eData.uid || "-", customerEmail: customerEmail, language: row[3], dateStr: dateClean,
      dayOfWeek: String(row[5]).replace(/'/g, ""), startTime: String(row[6]).replace(/'/g, ""), endTime: String(row[7]).replace(/'/g, ""),
      owner: row[8], meetLink: row[9], status: status, notes: eData.notes || "", officer: eData.officer || "", eddType: eData.eddType || "Unknown"
    });
  }
  return eventsList;
}

