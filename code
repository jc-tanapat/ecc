function getSystemSettings() {
  try {
    var currentUserEmail = Session.getActiveUser().getEmail() || "";
    var isBitkubUser = currentUserEmail.toLowerCase().endsWith('@bitkub.com') || currentUserEmail === "";
    var sheet = getTeamSheet();
    var data = sheet.getDataRange().getValues();
    var teamDatabase = {};
    for (var i = 1; i < data.length; i++) {
      if (data[i][0]) teamDatabase[String(data[i][0]).toLowerCase()] = { name: data[i][1], role: data[i][2], assignedTeam: data[i][3] };
    }
    if (Object.keys(teamDatabase).length === 0) {
      var props = PropertiesService.getScriptProperties();
      teamDatabase = props.getProperty("EDD_TEAM_DATABASE") ? JSON.parse(props.getProperty("EDD_TEAM_DATABASE")) : {};
    }
    var currentRole = "Viewer", userAssignedTeam = "none";
    var userKey = currentUserEmail.toLowerCase();
    if (teamDatabase[userKey]) {
      currentRole = teamDatabase[userKey].role;
      userAssignedTeam = teamDatabase[userKey].assignedTeam || "none";
    } else if (currentUserEmail === "") {
      currentRole = "Admin"; userAssignedTeam = "all";
      teamDatabase["admin"] = { role: "Admin", name: "Admin", assignedTeam: "all" };
    }
    return { success: true, currentUserEmail: currentUserEmail, currentRole: currentRole, userAssignedTeam: userAssignedTeam, teamDatabase: teamDatabase, isBitkubUser: isBitkubUser };
  } catch(e) { return { success: false, error: e.toString() }; }
}

function saveTeamDatabase(newTeamDbObj) {
  var lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    var currentUserEmail = Session.getActiveUser().getEmail() || "System Admin";
    var sheet = getTeamSheet(), logSheet = getLogSheet();
    var oldData = sheet.getDataRange().getValues(), oldDb = {};
    for (var i = 1; i < oldData.length; i++) {
      if (oldData[i][0]) oldDb[String(oldData[i][0]).toLowerCase()] = { name: oldData[i][1], role: oldData[i][2], assignedTeam: oldData[i][3] };
    }
    sheet.clear();
    sheet.appendRow(["Email", "Name", "Role", "AssignedTeam"]);
    sheet.getRange(1, 1, 1, 4).setFontWeight("bold").setBackground("#f3f4f6");
    var timestamp = Utilities.formatDate(new Date(), "GMT+7", "dd-MMM-yyyy HH:mm:ss");
    var rowsToAppend = [];
    for (var email in newTeamDbObj) {
      var member = newTeamDbObj[email];
      rowsToAppend.push([email, member.name, member.role, member.assignedTeam]);
      var oldMember = oldDb[email];
      if (!oldMember) { logSheet.appendRow([timestamp, currentUserEmail, "ADD USER", email, "Role: " + member.role + " | Queue: " + member.assignedTeam]); } 
      else if (oldMember.role !== member.role || oldMember.assignedTeam !== member.assignedTeam) { logSheet.appendRow([timestamp, currentUserEmail, "UPDATE USER", email, "Changed to Role: " + member.role + " | Queue: " + member.assignedTeam]); }
    }
    if (rowsToAppend.length > 0) sheet.getRange(2, 1, rowsToAppend.length, 4).setValues(rowsToAppend);
    for (var oldEmail in oldDb) {
      if (!newTeamDbObj[oldEmail]) logSheet.appendRow([timestamp, currentUserEmail, "DELETE USER", oldEmail, "Removed from system"]);
    }
    PropertiesService.getScriptProperties().setProperty("EDD_TEAM_DATABASE", JSON.stringify(newTeamDbObj));
    return { success: true };
  } catch(e) { return { success: false, error: e.toString() }; } finally { lock.releaseLock(); }
}

