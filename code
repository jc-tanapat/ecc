function saveToGoogleCalendar(ownerName, eventId, status, notes, officer, uid, eddType, customerEmail) {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(15000)) return { success: false, error: "System is busy, please try saving again." };
  try {
    var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    var editSheet = ss.getSheetByName(DB_EDIT_NAME);
    var data = editSheet.getDataRange().getValues();
    var found = false;
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][0]) === String(eventId)) {
        editSheet.getRange(i+1, 2, 1, 5).setValues([[uid, status, notes, officer, eddType]]);
        found = true; break;
      }
    }
    if (!found) editSheet.appendRow([eventId, uid, status, notes, officer, eddType, ""]);

    try {
      var targetSheetName = TEAM_SHEET_MAPPING[ownerName];
      if (targetSheetName) {
        var mainSheet = ss.getSheetByName(targetSheetName);
        if (mainSheet) {
          var mainData = mainSheet.getDataRange().getValues();
          var headers = mainData[0];
          var emailIdx = -1, uidIdx2 = -1, typeIdx2 = -1;
          for (var j = 0; j < headers.length; j++) {
            var hName = String(headers[j]).trim().toLowerCase();
            if (hName.indexOf("email") !== -1) emailIdx = j;
            if (hName.indexOf("uid") !== -1) uidIdx2 = j;
            if (hName.indexOf("type") !== -1) typeIdx2 = j;
          }
          if (emailIdx !== -1) {
            for (var k = 1; k < mainData.length; k++) {
              if (String(mainData[k][emailIdx]).trim().toLowerCase() === String(customerEmail).trim().toLowerCase()) {
                if (uidIdx2 !== -1) mainSheet.getRange(k+1, uidIdx2+1).setValue(uid);
                if (typeIdx2 !== -1) mainSheet.getRange(k+1, typeIdx2+1).setValue(eddType);
                break;
              }
            }
          }
        }
      }
    } catch(sheetErr) { }

    SpreadsheetApp.flush();

    var calendarId = EMAIL_MAP[ownerName];
    if (calendarId) {
      var safeStatus = String(status).trim().toLowerCase();
      if (safeStatus === "cancelled") {
        try { Calendar.Events.remove(calendarId, eventId); } catch(delErr) { Logger.log("Delete error: " + delErr); }
      } else if (safeStatus !== "blocked slot") {
        try {
          var cal = CalendarApp.getCalendarById(calendarId);
          if (cal) {
            var event = cal.getEventById(eventId);
            if (event) {
              var currentDesc = event.getDescription() || "";
              currentDesc = currentDesc.replace(/\[EDD_STATUS:\s*[^\]]+\]/g,"").replace(/\[EDD_NOTES:\s*[^\]]+\]/g,"").replace(/\[EDD_OFFICER:\s*[^\]]+\]/g,"").trim();
              var editorEmail = Session.getActiveUser().getEmail() || "Ops Command Station";
              var timestamp = Utilities.formatDate(new Date(), "GMT+7", "dd-MMM-yyyy HH:mm:ss");
              currentDesc += "\n\n[Edit Log - " + timestamp + " by " + editorEmail + "]\n   Assigned Officer: " + (officer||"Unassigned") + "\n   Status updated: " + status + "\n   UID Associated: " + uid + "\n   EDD Type Categorized: " + eddType + "\n   Operational Note: " + (notes||"-") + "\n\n[EDD_STATUS: " + status + "]\n[EDD_NOTES: " + (notes||"") + "]\n[EDD_OFFICER: " + (officer||"") + "]";
              event.setDescription(currentDesc);
              var colorMap = { "EDD Done": CalendarApp.EventColor.GREEN, "EDD Not done": CalendarApp.EventColor.RED, "Need check": CalendarApp.EventColor.YELLOW, "Transferred": CalendarApp.EventColor.MAUVE };
              if (colorMap[status]) event.setColor(colorMap[status]);
            }
          }
        } catch(calErr) {}
      }
    }
    return { success: true };
  } catch(e) { return { success: false, error: e.toString() }; } finally { lock.releaseLock(); }
}

