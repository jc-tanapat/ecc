function detectLanguage(title, description) {
  var fullText = (String(title) + " " + String(description)).toLowerCase();
  if (fullText.indexOf('english') !== -1 || fullText.indexOf('eng') !== -1 || fullText.indexOf('[eng]') !== -1) { return "English"; }
  return "Thai";
}

function sendSlackMessage(webhookUrl, textMsg) {
  if (!webhookUrl) return;
  try { UrlFetchApp.fetch(webhookUrl, { "method": "post", "contentType": "application/json", "payload": JSON.stringify({ "text": textMsg }), "muteHttpExceptions": true }); } catch(e) {}
}

// 🚀 แก้ไข: สกัดลิงก์โดยให้ Priority Google Meet ก่อน
function extractMeetLink(location, description, conferenceData) {
  var loc  = location || '';
  var desc = description || '';
  
  // 1. Google Meet แท้
  if (conferenceData && conferenceData.entryPoints) {
    for (var i = 0; i < conferenceData.entryPoints.length; i++) {
      if (conferenceData.entryPoints[i].entryPointType === 'video' && conferenceData.entryPoints[i].uri) {
        return conferenceData.entryPoints[i].uri;
      }
    }
  }
  // 2. ลิงก์ Meet ในข้อความ
  var fallback = (loc + ' ' + desc).match(/(https:\/\/)?meet\.google\.com\/[a-z0-9-]+/i);
  if (fallback) return fallback[0].startsWith('http') ? fallback[0] : 'https://' + fallback[0];
  
  // 3. YouCanBook.me
  var ycbm = (loc + ' ' + desc).match(/https:\/\/book\.youcanbook\.me\/google-meet\/[A-Za-z0-9_-]+/i);
  if (ycbm) return ycbm[0];
  
  return '';
}

