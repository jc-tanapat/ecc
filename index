      html += '</div>';

      html += '<div class="grid grid-cols-1 md:grid-cols-2 gap-6">';
      
      // 🚀 สร้างกราฟ Status Breakdown แสดงให้ครบทุก Status
      html += '<div class="glass-panel p-6 rounded-2xl text-left"><p class="font-bold text-xs text-gray-400 mb-5 uppercase tracking-wider">Status Breakdown</p>';
      const statusKeys = ['Need check', 'EDD Not done', 'EDD Done', 'Cancelled', 'Transferred', 'Blocked slot'];
      const statusColors = { 'Need check':'#EAB308', 'EDD Not done':'#EF4444', 'EDD Done':'#22C55E', 'Cancelled':'#9CA3AF', 'Transferred':'#6B7280', 'Blocked slot':'#1F2937' };
      statusKeys.forEach(function(s) { 
