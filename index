    function buildOfficerFilter() {
      const officerSelect = document.getElementById('officerFilter');
      const uniqueOfficers = new Set();
      
      for (const email in teamDatabase) {
        const officer = teamDatabase[email].name || email.split('@')[0];
        uniqueOfficers.add(officer);
      }
      
      Array.from(uniqueOfficers).sort().forEach(officer => {
        const opt = document.createElement('option');
        opt.value = officer;
        opt.textContent = officer;
        officerSelect.appendChild(opt);
      });
    }

    function saveRow(eventId, index, buttonElement) {
      const status = document.getElementById('status-' + eventId).value, 
            notes = document.getElementById('notes-' + eventId).value, 
            officer = document.getElementById('officer-' + eventId).value;
      
      const uidInputNode = document.getElementById('uid-input-' + eventId);
      let uid = (rawData.find(x => x.id === eventId)||{}).uid||'-';
      
      if (uidInputNode && !document.getElementById('uid-edit-block-'+eventId).classList.contains('hidden')) {
        const inputVal = uidInputNode.value.trim();
        if (inputVal === '') {
          Swal.fire({ icon: 'warning', title: 'UID Required', text: 'Please enter a UID or leave it unchanged.' });
          return;
        }
        uid = inputVal;
      }
      
      const typeInputNode = document.getElementById('eddType-input-' + eventId), 
            eddType = typeInputNode && !document.getElementById('type-edit-block-'+eventId).classList.contains('hidden') ? (typeInputNode.value.trim() || 'Unknown') : (rawData.find(x => x.id === eventId)||{}).eddType||'Unknown';
      
      const item = rawData.find(x => x.id === eventId) || {};
      buttonElement.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-xs"></i>'; 
      buttonElement.disabled = true;
      
      google.script.run.withSuccessHandler(function(res) {
        if (res && res.success) {
          buttonElement.innerHTML = '<i class="fa-solid fa-check text-xs"></i>'; 
          buttonElement.className = "w-8 h-8 btn-bitkub rounded-lg inline-flex items-center justify-center transition shadow-sm";
          setTimeout(function() { 
            buttonElement.innerHTML = '<i class="fa-solid fa-floppy-disk text-xs"></i>'; 
            buttonElement.className = "w-8 h-8 bg-gray-900 hover:bg-black text-white rounded-lg inline-flex items-center justify-center transition shadow-sm border border-gray-700"; 
            buttonElement.disabled = false; 
            
            let mItem = rawData.find(x => x.id === eventId);
            if(mItem) { 
              mItem.status = status; 
              mItem.notes = notes; 
              mItem.officer = officer; 
              mItem.uid = uid; 
              mItem.eddType = eddType; 
            }
            let fItem = filteredData.find(x => x.id === eventId);
            if(fItem) { 
              fItem.status = status; 
              fItem.notes = notes; 
              fItem.officer = officer; 
              fItem.uid = uid; 
              fItem.eddType = eddType; 
            }
            
            applyFilters();
            Swal.fire({ icon: 'success', title: 'Saved', text: 'บันทึกข้อมูลสำเร็จ!', timer: 1500, showConfirmButton: false }); 
          }, 1200);
        } else { 
          Swal.fire({ icon: 'error', title: 'Save Failed', text: res ? res.error : 'Unknown error' });
          buttonElement.innerHTML = '<i class="fa-solid fa-floppy-disk text-xs"></i>'; 
          buttonElement.disabled = false; 
        }
      }).saveToGoogleCalendar(item.owner, eventId, status, notes, officer, uid, eddType, item.customerEmail);
    }

    function openTransferModal(eventId, owner, dateStr, startTime, endTime) {
      document.getElementById('tx-event-id').value = eventId; 
      document.getElementById('tx-source-owner').value = owner;
      
      document.getElementById('tx-target-owner').value = owner;
      document.getElementById('tx-target-date').value = '';
      document.getElementById('tx-start-time').value = '';
      document.getElementById('tx-end-time').value = '';
      
      const mth = {'Jan':'01','Feb':'02','Mar':'03','Apr':'04','May':'05','Jun':'06','Jul':'07','Aug':'08','Sep':'09','Oct':'10','Nov':'11','Dec':'12'}, 
            p = dateStr.split('-');
      if (p.length === 3) {
        document.getElementById('tx-target-date').value = p[2] + "-" + (mth[p[1]]||"01") + "-" + p[0].padStart(2,'0');
      }
      document.getElementById('tx-start-time').value = startTime; 
      document.getElementById('tx-end-time').value = endTime;
      document.getElementById('transferModal').classList.remove('hidden');
    }

    function closeTransferModal() { 
      document.getElementById('transferModal').classList.add('hidden'); 
    }

    function confirmTransferExecution() {
      const eventId = document.getElementById('tx-event-id').value, 
            sourceOwner = document.getElementById('tx-source-owner').value, 
            targetOwner = document.getElementById('tx-target-owner').value, 
            targetDate = document.getElementById('tx-target-date').value, 
            startTime = document.getElementById('tx-start-time').value, 
            endTime = document.getElementById('tx-end-time').value;
      
      if (sourceOwner === targetOwner) { 
        Swal.fire({ icon: 'warning', title: 'Routing Blocked', text: 'ไม่สามารถโอนไปทีมเดิมได้ครับ' });
        return; 
      }
      
      const btn = document.getElementById('tx-submit-btn'); 
      btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-xs"></i> Tunneling...'; 
      btn.disabled = true;
      
      google.script.run.withSuccessHandler(function(res) {
        btn.innerHTML = '<i class="fa-solid fa-arrow-right-arrow-left mr-1.5"></i> Transfer'; 
        btn.disabled = false; 
        closeTransferModal();
        if (res && res.success) {
          Swal.fire({ icon: 'success', title: 'Transfer Complete', text: 'โอนคิวสำเร็จแล้ว!', timer: 2000, showConfirmButton: false }).then(() => {
            forceSyncAndFetch();
          });
        } else {
          Swal.fire({ icon: 'error', title: 'Transfer Failed', text: res ? res.error : "Unknown error" });
        }
      }).executeSlotTunnelTransfer(sourceOwner, eventId, targetOwner, targetDate, startTime, endTime);
    }

    function renderAdminTeamTable() {
      const tbody = document.getElementById('adminTeamTableBody'); 
      tbody.innerHTML = '';
      for (const email in teamDatabase) {
        const member = teamDatabase[email]; 
        if (!member) continue;
        const tr = document.createElement('tr'); 
        tr.className = "row-hover hover:bg-gray-50 dark:hover:bg-gray-800/50 transition text-sm border-b border-gray-200 dark:border-gray-800";
        tr.innerHTML = `
          <td class="p-4 font-mono break-words whitespace-normal border-r border-gray-200 dark:border-gray-800"><i class="fa-regular fa-envelope text-gray-400 mr-1.5"></i>${email}</td>
          <td class="p-4 border-r border-gray-200 dark:border-gray-800"><select onchange="updateRosterRole('${email}',this.value)" autocomplete="off" class="w-full apple-input"><option value="Staff" ${member.role==='Staff'?'selected':''}>Staff</option><option value="Admin" ${member.role==='Admin'?'selected':''}>Admin</option><option value="Viewer" ${member.role==='Viewer'?'selected':''}>Viewer</option></select></td>
          <td class="p-4 border-r border-gray-200 dark:border-gray-800"><select onchange="updateRosterQueue('${email}',this.value)" autocomplete="off" class="w-full apple-input"><option value="all" ${member.assignedTeam==='all'?'selected':''}>All Tasks Scope</option><option value="opskyc" ${member.assignedTeam==='opskyc'?'selected':''}>opskyc</option><option value="operationkyc" ${member.assignedTeam==='operationkyc'?'selected':''}>operationkyc</option><option value="verification-kyc" ${member.assignedTeam==='verification-kyc'?'selected':''}>verification-kyc</option><option value="opsverification" ${member.assignedTeam==='opsverification'?'selected':''}>opsverification</option><option value="opsmule" ${member.assignedTeam==='opsmule'?'selected':''}>opsmule</option></select></td>
          <td class="p-4 text-center"><button onclick="deleteTeamMemberRow('${email}')" class="text-red-400 hover:text-red-600 transition"><i class="fa-solid fa-trash-can text-base"></i></button></td>
        `;
        tbody.appendChild(tr);
      }
    }

    function updateRosterRole(email, val) { 
      if(teamDatabase[email]) teamDatabase[email].role = val; 
    }

    function updateRosterQueue(email, val) { 
      if(teamDatabase[email]) teamDatabase[email].assignedTeam = val; 
    }

    function addTeamMemberRow() {
      const raw = document.getElementById('new-team-emails').value, 
            role = document.getElementById('new-team-role').value, 
            queue = document.getElementById('new-team-queue').value;
      
      if (!raw.trim()) { 
        Swal.fire({ icon: 'warning', title: 'Input Required', text: 'Please enter emails.' });
        return; 
      }
      
      let count = 0; 
      raw.split(/[\n,;\s]+/).forEach(function(e) { 
        const email = e.trim(); 
        if (email && email.includes('@')) { 
          teamDatabase[email] = { role: role, name: email.split('@')[0], assignedTeam: queue }; 
          count++; 
        } 
      });
      
      document.getElementById('new-team-emails').value = ''; 
      renderAdminTeamTable(); 
      Swal.fire({ icon: 'success', title: 'Members Added', text: count + " member(s) registered. Don't forget to Save & Sync.", timer: 2000 });
    }

    function deleteTeamMemberRow(email) { 
      const self = document.getElementById('user-display-email').innerText; 
      if (email === self) { 
        Swal.fire({ icon: 'error', title: 'Blocked', text: 'You cannot remove yourself.' });
        return; 
      } 
      Swal.fire({
        title: 'Remove Member?', text: `Remove ${email} from access list?`, icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33', cancelButtonColor: '#3085d6', confirmButtonText: 'Yes, delete it!'
      }).then((result) => {
        if (result.isConfirmed) {
          delete teamDatabase[email]; 
          renderAdminTeamTable(); 
        }
      });
    }
    
    function saveAdminConsole() { 
      if (userRole !== "Admin") return; 
      google.script.run
        .withSuccessHandler(function(res) { 
          if (res.success) {
            Swal.fire({ icon: 'success', title: 'Saved to Database', text: 'Team Access and Action Logs synced successfully.', timer: 2000 }).then(() => {
              initAppInternal(function(){ switchTab('daily'); }); 
            });
          } else {
            Swal.fire({ icon: 'error', title: 'Save Error', text: "Failed to sync: " + res.error });
          }
        })
        .saveTeamDatabase(teamDatabase); 
    }
    
    function resetFilters() { 
      document.getElementById('searchFilter').value = ''; 
      document.getElementById('eddTypeFilter').value = ''; 
      document.getElementById('statusFilter').value = ''; 
      document.getElementById('officerFilter').value = ''; 
      toggleOwnerFilter('all'); 
    }

    function exportToCSV() { 
      if (filteredData.length === 0) { 
        Swal.fire({ icon: 'warning', title: 'No Data', text: 'No records to export.' });
        return; 
      } 
      let csv = "\uFEFF"; 
      csv += "Date,Time,UID,Customer Email,Language,EDD Type,Status,Officer,Notes,Owner\n"; 
      filteredData.forEach(function(item) { 
        csv += '"'+item.dateStr+'","'+item.startTime+' - '+item.endTime+'","'+item.uid+'","'+item.customerEmail+'","'+item.language+'","'+item.eddType+'","'+item.status+'","'+(item.officer||'')+'","'+(item.notes||'').replace(/"/g,'""')+'","'+item.owner.toUpperCase()+'"\n'; 
      }); 
      const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'}); 
      const link = document.createElement('a'); 
      link.href = URL.createObjectURL(blob); 
      link.download = 'EDD_Report_' + document.getElementById('datePicker').value + '.csv'; 
      document.body.appendChild(link); 
      link.click(); 
      document.body.removeChild(link); 
    }
  </script>
</body>
