  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    let rawData = [], filteredData = [], currentSelectedOwner = 'all', currentMode = 'daily', userRole = "Viewer", userAssignedTeam = "none", teamDatabase = {}, isEmailMasked = true, knownEventIds = null, autoRefreshInterval = null;

    window.addEventListener('load', function() {
      try {
        document.body.classList.remove('dark-theme-mode');
        
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('datePicker').value = today; 
        document.getElementById('endDatePicker').value = today;
        
        initAppInternal(function() {
          forceSyncAndFetch();
          autoRefreshInterval = setInterval(function() { 
            google.script.run.withSuccessHandler(function() { fetchData(true); }).checkNewEventsAndNotifySlack();
          }, 60000);
        });
      } catch (err) {
        document.body.innerHTML = `<div style="padding: 40px; color: red; text-align: center; font-family: sans-serif;"><h3>Application Load Error</h3><p>${err.message}</p></div>`;
      }
    });

    function getDisplayEmail(email) {
      if (!email || email === "-") return '-'; 
      if (!isEmailMasked) return email;
      const p = email.split('@'); 
      if (p.length < 2) return email;
      return (p[0].length <= 3 ? p[0][0] + '***' : p[0].substring(0, 3) + '***') + '@' + p[1];
    }

    function showWebAlert(title, message, isSuccess, onClose) {
      const modal = document.getElementById('customWebModal'), icon = document.getElementById('modal-icon-container');
      document.getElementById('modal-title').innerText = title; 
      document.getElementById('modal-text').innerText = message;
      icon.className = "w-16 h-16 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 " + (isSuccess ? "bg-green-100 text-green-600" : "bg-red-100 text-red-600");
      icon.innerHTML = isSuccess ? '<i class="fa-solid fa-circle-check"></i>' : '<i class="fa-solid fa-circle-exclamation"></i>';
      document.getElementById('modal-actions').innerHTML = '<button onclick="closeCustomModal()" class="flex-1 py-3 btn-bitkub text-white font-semibold text-sm rounded-xl transition">OK</button>';
      document._modalOnClose = onClose || null; 
      modal.classList.remove('hidden');
    }

    function showWebConfirm(title, message, onConfirm) {
      const modal = document.getElementById('customWebModal'), icon = document.getElementById('modal-icon-container');
      document.getElementById('modal-title').innerText = title; 
      document.getElementById('modal-text').innerText = message;
      icon.className = "w-16 h-16 bg-yellow-100 text-yellow-600 rounded-full flex items-center justify-center text-3xl mx-auto mb-4";
      icon.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
      document.getElementById('modal-actions').innerHTML = `<button onclick="closeCustomModal()" class="flex-1 py-3 bg-gray-200 text-gray-700 dark:bg-gray-800 dark:text-gray-300 font-semibold text-sm rounded-xl border border-transparent transition hover:bg-gray-300 dark:hover:bg-gray-700">Cancel</button><button id="confirm-ok-btn" class="flex-1 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold text-sm rounded-xl transition">Confirm</button>`;
      document.getElementById('confirm-ok-btn').onclick = function() { closeCustomModal(); if(onConfirm) onConfirm(); };
      document._modalOnClose = null; 
      modal.classList.remove('hidden');
    }

    function closeCustomModal() { 
      document.getElementById('customWebModal').classList.add('hidden'); 
      if(document._modalOnClose){document._modalOnClose(); document._modalOnClose=null;} 
    }

    function initAppInternal(callback) {
      google.script.run
      .withFailureHandler(function(err){ 
         document.getElementById('loading-screen').innerHTML = `<div style="color:red;">Error: ${err.message}</div>`;
      })
      .withSuccessHandler(function(settings) {
        userRole = settings.currentRole; 
        userAssignedTeam = settings.userAssignedTeam; 
        teamDatabase = settings.teamDatabase;
        
        document.getElementById('loading-screen').style.display = 'none';
        document.getElementById('main-app-shell').classList.remove('hidden');

        const adminBtn = document.getElementById('tab-btn-admin');
        if (userRole === 'Admin') { 
            adminBtn.classList.remove('hidden'); 
            renderAdminTeamTable(); 
        } else {
            adminBtn.classList.add('hidden');
        }

        document.getElementById('user-display-email').innerText = settings.currentUserEmail;
        document.getElementById('user-display-role').innerText = settings.currentRole + (userRole === "Staff" ? " (" + userAssignedTeam + ")" : "");
        buildOfficerFilter(); 
        if (callback) callback();
      }).getSystemSettings();
    }

    function toggleAppThemeMode() {
      const body = document.body, icon = document.getElementById('theme-toggle-icon'); 
      body.classList.toggle('dark-theme-mode');
      icon.className = body.classList.contains('dark-theme-mode') ? "fa-solid fa-sun text-base text-yellow-500" : "fa-solid fa-moon text-base text-indigo-500";
    }

    function toggleEmailMasking() { 
      isEmailMasked = !isEmailMasked; 
      document.getElementById('mask-icon').className = isEmailMasked ? "fa-solid fa-eye-slash text-sm text-gray-400" : "fa-solid fa-eye text-sm text-blue-500"; 
      renderTable(); 
      
      document.querySelectorAll('[id^="officer-"]').forEach(select => {
        const options = select.querySelectorAll('option');
        options.forEach(opt => {
          if (opt.value && opt.value.includes('@')) {
            opt.textContent = getDisplayEmail(opt.value);
          }
        });
      });
    }

    function switchTab(mode) {
      if (currentMode === mode) return;
      currentMode = mode;
      
      document.getElementById('date-label-text').innerText = mode === 'daily' ? "Target Date" : "Start Date";
      
      const endDateContainer = document.getElementById('end-date-container');
      if (mode === 'range') endDateContainer.classList.remove('hidden');
      else endDateContainer.classList.add('hidden');
      
      ['daily','range','admin'].forEach(function(t) {
        const btn = document.getElementById('tab-btn-' + t); 
        if(btn) btn.className = t === mode ? "px-5 py-2.5 bg-blue-100 text-blue-600 dark:bg-blue-900 dark:text-blue-400 font-semibold text-sm rounded-xl whitespace-nowrap focus:outline-none transition-all shadow-sm" : "px-5 py-2.5 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 font-medium text-sm rounded-xl whitespace-nowrap focus:outline-none transition-all";
      });
      
      const container = document.getElementById('tab-content-container');
      container.classList.remove('view-visible');
      
      setTimeout(function() {
        const filterPanel = document.getElementById('main-filter-panel');
        const queuePanel = document.getElementById('queue-filter-panel');
        const dailyPanel = document.getElementById('daily-kpi-panel');
        const rangePanel = document.getElementById('range-stats-panel');
        const tablePanel = document.getElementById('main-table-panel');
        const adminViewEl = document.getElementById('admin-view');

        if (mode === 'admin') {
           filterPanel.style.display = 'none';
           queuePanel.style.display = 'none';
           dailyPanel.style.display = 'none';
           rangePanel.style.display = 'none';
           tablePanel.style.display = 'none';
           
           adminViewEl.classList.remove('hidden');
           renderAdminTeamTable();
           
           if (autoRefreshInterval) {
             clearInterval(autoRefreshInterval);
             autoRefreshInterval = null;
           }
        } else {
           filterPanel.style.display = 'flex';
           queuePanel.style.display = 'flex';
           tablePanel.style.display = 'block';
           
           adminViewEl.classList.add('hidden');
           
           if (!autoRefreshInterval) {
             autoRefreshInterval = setInterval(function() { 
               google.script.run.withSuccessHandler(function() { fetchData(true); }).checkNewEventsAndNotifySlack();
             }, 60000);
           }
          
          if (mode === 'daily') {
            dailyPanel.style.display = 'grid';
            rangePanel.style.display = 'none';
            forceSyncAndFetch();
          } else {
            dailyPanel.style.display = 'none';
            rangePanel.style.display = 'block';
            fetchData(false);
          }
        }
        container.classList.add('view-visible');
      }, 300);
    }

    function toggleOwnerFilter(owner) {
      currentSelectedOwner = owner;
      const themes = {
        'all': { a: "bg-blue-600 text-white shadow-sm border border-transparent", i: "bg-transparent text-gray-500 border border-gray-300 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800" },
        'opskyc': { a: "badge-opskyc shadow-sm", i: "bg-transparent text-blue-600 border border-blue-200 hover:bg-blue-50 dark:text-blue-400 dark:border-blue-800 dark:hover:bg-blue-900" },
        'operationkyc': { a: "badge-oper shadow-sm", i: "bg-transparent text-orange-600 border border-orange-200 hover:bg-orange-50 dark:text-orange-400 dark:border-orange-800 dark:hover:bg-orange-900" },
        'verification-kyc': { a: "badge-vkyc shadow-sm", i: "bg-transparent text-purple-600 border border-purple-200 hover:bg-purple-50 dark:text-purple-400 dark:border-purple-800 dark:hover:bg-purple-900" },
        'opsverification': { a: "badge-over shadow-sm", i: "bg-transparent text-teal-600 border border-teal-200 hover:bg-teal-50 dark:text-teal-400 dark:border-teal-800 dark:hover:bg-teal-900" },
        'opsmule': { a: "badge-opsmule shadow-sm", i: "bg-transparent text-stone-600 border border-stone-200 hover:bg-stone-50 dark:border-stone-800 dark:text-stone-400 dark:hover:bg-stone-900" } 
      };
      ['all','opskyc','operationkyc','verification-kyc','opsverification','opsmule'].forEach(function(t) {
        const btn = document.getElementById('tab-' + t); 
        if (btn) btn.className = "px-4 py-1.5 text-xs font-semibold rounded-full transition " + (t === owner ? themes[t].a : themes[t].i);
      });
      applyFilters();
    }

    function forceSyncAndFetch() {
      if (currentMode === 'admin') return;
      let btn = document.getElementById('refresh-btn');
      if (btn) btn.innerHTML = '<i class="fa-solid fa-arrows-rotate fa-spin mr-1.5"></i> <span>Syncing...</span>';
      
      fetchData(false);
      google.script.run.checkNewEventsAndNotifySlack();
      
      setTimeout(() => { 
        if(btn) btn.innerHTML = '<i class="fa-solid fa-arrows-rotate mr-1.5"></i> <span>Refresh</span>'; 
      }, 2000);
    }

    function fetchData(isSilent = false) {
      if (currentMode === 'admin') return;
      const start = document.getElementById('datePicker').value, end = document.getElementById('endDatePicker').value;
      
      google.script.run
      .withFailureHandler(function(err){ 
        Swal.fire({ icon: 'error', title: 'Load Error', text: "Unable to load events: " + err.message });
      })
      .withSuccessHandler(function(masterData) {
        
        let idMap = {};
        masterData.forEach(item => {
            if (!idMap[item.id]) {
                idMap[item.id] = item;
            } else {
                const getPriority = (st) => {
                    if (st === 'Need check') return 4;
                    if (st === 'EDD Done' || st === 'EDD Not done') return 3;
                    if (st === 'Transferred') return 2;
                    if (st === 'Cancelled') return 1;
                    if (st === 'Blocked slot') return 0;
                    return 0;
                };
                if (getPriority(item.status) > getPriority(idMap[item.id].status)) {
                    idMap[item.id] = item;
                }
            }
        });

        let deduped = Object.values(idMap);

        const mMap = {'Jan':'01','Feb':'02','Mar':'03','Apr':'04','May':'05','Jun':'06','Jul':'07','Aug':'08','Sep':'09','Oct':'10','Nov':'11','Dec':'12'};
        let sorted = deduped.sort((a, b) => {
          let pA = a.dateStr.split('-'); 
          let pB = b.dateStr.split('-');
          let valA = pA.length === 3 ? parseInt(pA[2] + mMap[pA[1]] + pA[0] + a.startTime.replace(':',''), 10) : 0;
          let valB = pB.length === 3 ? parseInt(pB[2] + mMap[pB[1]] + pB[0] + b.startTime.replace(':',''), 10) : 0;
          return valA - valB; 
        });
        
        rawData = sorted;

        let newAlerts = [];
        
        if (isSilent && knownEventIds !== null) {
          rawData.forEach(function(item) {
            if (!knownEventIds.has(item.id)) {
              newAlerts.push(item);
              knownEventIds.add(item.id);
            }
          });
        } else {
          knownEventIds = new Set(rawData.map(function(i){ return i.id; }));
        }

        if (newAlerts.length > 0 && isSilent) {
          const prettyMap = {'opskyc':'opskyc (KYC Risk)','operationkyc':'operationkyc (KYC)','verification-kyc':'verification-kyc (Mule)','opsverification':'opsverification (OPS)','opsmule':'opsmule (OPS Mule)'};
          let msg = "มี Slot ใหม่ถูกจองเข้ามา:\n\n"; 
          newAlerts.forEach(function(b){ 
            if (b.status !== "Blocked slot") { // ไม่แจ้งเตือน Blocked slot
              msg += "\u2022 [" + (prettyMap[b.owner] || b.owner) + "]\n  " + b.dateStr + " \u2022 " + b.startTime + " \u0e19.\n\n"; 
            }
          });
          if (msg !== "มี Slot ใหม่ถูกจองเข้ามา:\n\n") Swal.fire({ icon: 'info', title: '🔔 นัดหมายใหม่เข้ามา!', text: msg });
        }
        
        applyFilters(); 
        document.getElementById('liveTime').innerText = new Date().toLocaleTimeString('en-US', { hour12: false });
      }).getMasterCombinedCalendarData(start, currentMode === 'daily' ? null : end);
    }

    function applyFilters() {
      try {
        const search = document.getElementById('searchFilter').value.toLowerCase(), 
              status = document.getElementById('statusFilter').value, 
              eddType = document.getElementById('eddTypeFilter').value.toLowerCase(), 
              officerF = document.getElementById('officerFilter').value;
        
        filteredData = rawData.filter(function(item) {
          // 🚀 ซ่อน Blocked Slot ออกจากหน้า Daily Operations เด็ดขาด
          let isBlocked = (item.customerEmail === '-' || item.status === 'Blocked slot');
          if (currentMode === 'daily' && isBlocked) return false;

          return ((item.customerEmail||"").toLowerCase().includes(search) || (item.title||"").toLowerCase().includes(search) || (item.uid||"").toLowerCase().includes(search))
            && (status === "" || (item.status || "Need check") === status) 
            && (eddType === "" || (item.eddType || "Unknown").toLowerCase().includes(eddType)) 
            && (officerF === "" || (item.officer || "") === officerF) 
            && (currentSelectedOwner === 'all' || item.owner === currentSelectedOwner);
        });
        
        document.getElementById('record-count-badge').innerText = filteredData.length + " record" + (filteredData.length !== 1 ? "s" : "");
        renderTable(); 
        calculateKPIsAndInsights();
        
        if (currentMode === 'range') updateRangeStatsLocally();
      } catch(e) { console.error(e); }
    }

    function updateRangeStatsLocally() {
      const total = filteredData.length;
      const stats = {
          total: total,
          byStatus: { 'Need check':0, 'EDD Not done':0, 'EDD Done':0, 'Cancelled':0, 'Transferred':0, 'Blocked slot':0 },
          byOwner: { 'opskyc':0, 'operationkyc':0, 'verification-kyc':0, 'opsverification':0, 'opsmule':0 }
      };
      filteredData.forEach(item => {
          let st = item.status || 'Need check';
          if (stats.byStatus[st] !== undefined) stats.byStatus[st]++;
          else stats.byStatus[st] = 1;

          let ow = item.owner;
          if (stats.byOwner[ow] !== undefined) stats.byOwner[ow]++;
          else stats.byOwner[ow] = 1;
      });
      renderRangeAnalytics(stats);
    }

    function calculateKPIsAndInsights() {
      try {
        const total = filteredData.length; 
        document.getElementById('insight-total-cases').innerText = total + " Cases";
        const chartBox = document.getElementById('edd-type-chart-container');
        if (chartBox) {
          chartBox.innerHTML = ''; 
          if (total === 0) { 
            chartBox.innerHTML = '<p class="text-sm text-gray-400 text-center py-6">No data available</p>'; 
          } else {
            const typeCounts = {}; 
            filteredData.forEach(function(item){ 
              const t = item.eddType || 'Unknown'; 
              typeCounts[t] = (typeCounts[t]||0)+1; 
            });
            // 🚀 ฝังรหัสสีตรงๆ เพื่อป้องกันบั๊ก Tailwind CSS ไม่โหลดสีที่ไม่ได้เรียกใช้
            const hexColors = ['#3B82F6', '#10B981', '#8B5CF6', '#F59E0B', '#EC4899', '#14B8A6', '#6366F1', '#F43F5E'];
            Object.keys(typeCounts).sort(function(a,b){ return typeCounts[b]-typeCounts[a]; }).forEach(function(type, idx) {
              const count = typeCounts[type], pct = Math.round((count/total)*100);
              const barColor = hexColors[idx % hexColors.length];
              chartBox.innerHTML += `<div class="mb-3"><div class="flex justify-between text-xs font-medium mb-1.5"><span class="truncate pr-2" title="${type}">${type}</span><span class="text-gray-500">${pct}% (${count})</span></div><div class="w-full h-2 rounded-full overflow-hidden" style="background-color: var(--border-color)"><div class="h-full range-bar" style="background-color:${barColor}; width:${pct}%;"></div></div></div>`;
            });
          }
        }
        const uO = filteredData.filter(function(i){return i.owner==='opskyc';}).length, 
              uK = filteredData.filter(function(i){return i.owner==='operationkyc';}).length;
        const uV = filteredData.filter(function(i){return i.owner==='verification-kyc';}).length, 
              uP = filteredData.filter(function(i){return i.owner==='opsverification';}).length,
              uM = filteredData.filter(function(i){return i.owner==='opsmule';}).length; 
        
        [['opskyc',uO,'txt-u-opskyc','bar-u-opskyc','bar-opskyc'],
         ['oper',uK,'txt-u-oper','bar-u-oper','bar-oper'],
         ['vkyc',uV,'txt-u-vkyc','bar-u-vkyc','bar-vkyc'],
         ['over',uP,'txt-u-over','bar-u-over','bar-over'],
         ['opsmule',uM,'txt-u-opsmule','bar-u-opsmule','bar-opsmule'] 
        ].forEach(function(arr){
          const pct = total ? Math.round((arr[1]/total)*100) : 0; 
          const txtEl = document.getElementById(arr[2]);
          if(txtEl) txtEl.innerText = pct+'% ('+arr[1]+')'; 
          const bar = document.getElementById(arr[3]);
          if(bar) { 
            bar.style.width = pct+'%'; 
            bar.className = `h-full range-bar ${arr[4]}`; 
          }
        });
        
        const done = filteredData.filter(function(i){return i.status==='EDD Done';}).length;
        document.getElementById('insight-lang-th').innerText = filteredData.filter(function(i){return i.language.toLowerCase().includes('thai');}).length;
        document.getElementById('insight-lang-en').innerText = filteredData.filter(function(i){return !i.language.toLowerCase().includes('thai');}).length;
        document.getElementById('kpi-done').innerText = done; 
        document.getElementById('kpi-notdone').innerText = filteredData.filter(function(i){return i.status==='EDD Not done';}).length;
        document.getElementById('insight-sla-pending').innerText = filteredData.filter(function(i){return i.status==='Need check';}).length + " Items";
        document.getElementById('txt-done-percent').innerText = 'Done: ' + (total ? Math.round((done/total)*100) : 0) + '%';
      } catch(e) { console.error(e); }
    }

