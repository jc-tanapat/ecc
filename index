      html += `<div class="glass-panel p-6 rounded-2xl flex flex-col justify-center items-center text-center"><div class="text-5xl font-light tracking-tight text-green-500 mb-1">${stats.byStatus['EDD Done']||0}</div><div class="text-[11px] font-bold text-gray-400 uppercase tracking-widest">Completed</div></div>`;
