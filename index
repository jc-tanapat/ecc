<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <base target="_top">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="https://www.bitkub.com/favicon.ico">
  <style>@import url('https://fonts.cdnfonts.com/css/sf-pro-display');</style>
  
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
  
  <style>
    :root {
      --bg-main: #F5F5F7; 
      --bg-card: #FFFFFF; 
      --text-main: #1D1D1F; 
      --text-muted: #86868B; 
      --border-color: rgba(0, 0, 0, 0.08);
      --btn-primary: #007AFF;
      --btn-hover: #005bb5;
    }
    
    body.dark-theme-mode {
      --bg-main: #000000; 
      --bg-card: #1C1C1E; 
      --text-main: #F5F5F7; 
      --text-muted: #98989D; 
      --border-color: rgba(255, 255, 255, 0.12);
      --btn-primary: #0A84FF;
      --btn-hover: #0066cc;
    }
    
    body { background-color: var(--bg-main); color: var(--text-main); transition: background-color 0.3s ease, color 0.3s ease; font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
    
    .glass-panel { background: var(--bg-card); backdrop-filter: saturate(180%) blur(24px); -webkit-backdrop-filter: saturate(180%) blur(24px); border: 1px solid var(--border-color); border-radius: 18px; box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04); transition: all 0.3s ease; }
    body.dark-theme-mode .glass-panel { box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4); }
    
    .text-muted-style { color: var(--text-muted); }
    .btn-bitkub { background-color: #00B976; color: #ffffff; border: none; }
    .btn-bitkub:hover { background-color: #009a62; }

    .apple-input { background-color: rgba(0,0,0,0.04) !important; border: 1px solid transparent !important; color: var(--text-main) !important; border-radius: 10px; font-size: 14px; transition: all 0.2s ease; padding: 8px 12px; }
    body.dark-theme-mode .apple-input { background-color: rgba(255,255,255,0.08) !important; border: 1px solid rgba(255,255,255,0.05) !important; }
    .apple-input:focus { background-color: var(--bg-card) !important; border-color: #007AFF !important; box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.2) !important; outline: none; }
    
    table { border-collapse: separate; border-spacing: 0; }
    th { color: var(--text-muted); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid var(--border-color); }
    td { border-bottom: 1px solid var(--border-color); }
    
    tr.row-hover:hover td { background-color: rgba(0, 122, 255, 0.04); }
    body.dark-theme-mode tr.row-hover:hover td { background-color: rgba(255, 255, 255, 0.05); }
    
    .sla-pulse { animation: pulse-red 2s infinite; }
    @keyframes pulse-red { 0%,100%{opacity:1} 50%{opacity:0.4} }
    
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.2); border-radius: 99px; }
    body.dark-theme-mode ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.3); }
    
    .view-transition { opacity: 0; transform: translateY(12px); transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
    .view-visible { opacity: 1; transform: translateY(0); }
    .fade-in-scale { animation: popIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes popIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
    .range-bar { transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1); }

    .badge-opskyc { background-color: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
    .badge-oper { background-color: #fff7ed; color: #c2410c; border-color: #fed7aa; }
    .badge-vkyc { background-color: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }
    .badge-over { background-color: #f0fdfa; color: #0f766e; border-color: #99f6e4; }
    .badge-opsmule { background-color: #efebe9; color: #4e342e; border-color: #d7ccc8; } 
    
    body.dark-theme-mode .badge-opskyc { background-color: rgba(30, 58, 138, 0.3); color: #60a5fa; border-color: rgba(30, 58, 138, 0.5); }
    body.dark-theme-mode .badge-oper { background-color: rgba(124, 45, 18, 0.3); color: #fb923c; border-color: rgba(124, 45, 18, 0.5); }
    body.dark-theme-mode .badge-vkyc { background-color: rgba(88, 28, 135, 0.3); color: #c084fc; border-color: rgba(88, 28, 135, 0.5); }
    body.dark-theme-mode .badge-over { background-color: rgba(19, 78, 74, 0.3); color: #2dd4bf; border-color: rgba(19, 78, 74, 0.5); }
    body.dark-theme-mode .badge-opsmule { background-color: rgba(78, 52, 46, 0.3); color: #bcaaa4; border-color: rgba(78, 52, 46, 0.5); } 

    .bar-opskyc { background-color: #3b82f6 !important; }
    .bar-oper { background-color: #f97316 !important; }
    .bar-vkyc { background-color: #a855f7 !important; }
    .bar-over { background-color: #14b8a6 !important; }
    .bar-opsmule { background-color: #8d6e63 !important; } 

    .lang-th { background-color: #f0fdf4; color: #166534; border-color: #bbf7d0; }
    .lang-en { background-color: #eff6ff; color: #1e3a8a; border-color: #bfdbfe; }
    .lang-int { background-color: #fffbeb; color: #854d0e; border-color: #fde68a; }
    
    body.dark-theme-mode .lang-th { background-color: rgba(20, 83, 45, 0.3); color: #4ade80; border-color: rgba(20, 83, 45, 0.5); }
    body.dark-theme-mode .lang-en { background-color: rgba(30, 58, 138, 0.3); color: #60a5fa; border-color: rgba(30, 58, 138, 0.5); }
    body.dark-theme-mode .lang-int { background-color: rgba(113, 63, 18, 0.3); color: #facc15; border-color: rgba(113, 63, 18, 0.5); }

    .hidden { display: none !important; }
  </style>
</head>
<body class="min-h-screen antialiased p-4 lg:p-6">

  <div id="loading-screen" style="position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background-color: var(--bg-main); z-index: 9999;">
    <div class="text-center fade-in-scale" style="text-align: center;">
      <div class="btn-bitkub" style="width: 48px; height: 48px; border-radius: 16px; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">
        <i class="fa-solid fa-shield-halved" style="color: white; font-size: 20px;"></i>
      </div>
      <div style="font-size: 14px; font-weight: 600; color: #8E8E93;">Authorizing Access...</div>
    </div>
  </div>

  <div id="main-app-shell" class="hidden w-full mx-auto fade-in">
    
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4 pb-5 border-b border-gray-200 dark:border-gray-800">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 btn-bitkub rounded-xl flex items-center justify-center text-white shadow-sm"><i class="fa-solid fa-shield-halved text-lg"></i></div>
        <div>
          <h1 class="text-lg font-bold tracking-tight leading-tight">EDD Command Center</h1>
          <p class="text-xs text-muted-style mt-0.5">Unified Operations Command · Role-Based Access · Live BI Analytics</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2 glass-panel px-3 py-1.5 rounded-xl text-xs font-semibold shadow-sm">
          <div class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse"></div>
          <span class="text-muted-style">System Live</span>
        </div>
        <button onclick="toggleAppThemeMode()" class="w-10 h-10 glass-panel rounded-xl flex items-center justify-center hover:opacity-80 transition shadow-sm focus:outline-none"><i id="theme-toggle-icon" class="fa-solid fa-moon text-base text-yellow-500"></i></button>
        <div class="flex flex-col text-right text-xs text-muted-style font-medium glass-panel p-2 px-3.5 rounded-xl shadow-sm">
          <div>User: <span id="user-display-email" class="text-blue-500 font-semibold">-</span></div>
          <div>Role: <span id="user-display-role" class="font-semibold text-gray-500 dark:text-gray-400">-</span> · <span class="text-[10px] opacity-60"><span id="liveTime">-</span></span></div>
        </div>
      </div>
    </header>

    <div class="flex mb-5 gap-2 overflow-x-auto px-1 pb-1">
      <button onclick="switchTab('daily')" id="tab-btn-daily" class="px-5 py-2.5 bg-blue-100 text-blue-600 dark:bg-blue-900 dark:text-blue-400 font-semibold text-sm rounded-xl whitespace-nowrap focus:outline-none transition-all shadow-sm">Daily Operations</button>
      <button onclick="switchTab('range')" id="tab-btn-range" class="px-5 py-2.5 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 font-medium text-sm rounded-xl whitespace-nowrap focus:outline-none transition-all">Range Analytics</button>
      <button onclick="switchTab('admin')" id="tab-btn-admin" class="hidden px-5 py-2.5 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 font-medium text-sm rounded-xl whitespace-nowrap focus:outline-none transition-all">Team &amp; Access Settings</button>
    </div>

    <div id="tab-content-container" class="view-transition view-visible">
      
      <div id="main-filter-panel" class="glass-panel p-5 mb-5 flex flex-col lg:flex-row gap-4 items-end justify-between rounded-2xl">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 w-full">
          <div><label id="date-label-text" class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-1.5">Target Date</label><input type="date" id="datePicker" autocomplete="off" class="w-full apple-input" onchange="forceSyncAndFetch()"></div>
          <div id="end-date-container" class="hidden"><label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-1.5">End Date</label><input type="date" id="endDatePicker" autocomplete="off" class="w-full apple-input" onchange="forceSyncAndFetch()"></div>
          <div class="relative"><label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-1.5">Search</label><i class="fa-solid fa-magnifying-glass absolute left-3 top-[38px] text-gray-400 text-xs"></i><input type="text" id="searchFilter" autocomplete="off" placeholder="Email, UID, Title..." class="w-full pl-8 apple-input" oninput="applyFilters()"></div>
          <div><label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-1.5">EDD Type</label><input type="text" id="eddTypeFilter" autocomplete="off" placeholder="Filter Type..." class="w-full apple-input" oninput="applyFilters()"></div>
          <div><label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-1.5">Status</label>
            <select id="statusFilter" autocomplete="off" class="w-full apple-input" onchange="applyFilters()">
              <option value="">All Statuses</option>
              <option value="Need check">Need check</option>
              <option value="EDD Not done">EDD Not done</option>
              <option value="EDD Done">EDD Done</option>
              <option value="Cancelled">Cancelled</option>
              <option value="Transferred">Transferred</option>
              <option value="Blocked slot">Blocked slot</option>
            </select>
          </div>
          <div><label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-1.5">Officer</label><select id="officerFilter" autocomplete="off" class="w-full apple-input" onchange="applyFilters()"><option value="">All Officers</option></select></div>
        </div>
        <div class="flex gap-2 w-full lg:w-auto justify-end flex-wrap">
          <button id="refresh-btn" onclick="forceSyncAndFetch()" class="px-4 py-2.5 btn-bitkub rounded-xl text-sm font-semibold shadow-sm focus:outline-none transition"><i class="fa-solid fa-arrows-rotate mr-1.5"></i> <span>Refresh</span></button>
          <button onclick="resetFilters()" class="px-4 py-2.5 bg-gray-200 text-gray-700 dark:bg-gray-800 dark:text-gray-300 rounded-xl text-sm font-semibold focus:outline-none transition hover:bg-gray-300 dark:hover:bg-gray-700"><i class="fa-solid fa-arrow-rotate-left mr-1.5"></i> Reset</button>
          <button onclick="exportToCSV()" class="px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow-sm focus:outline-none transition"><i class="fa-solid fa-file-excel mr-1.5"></i> Export CSV</button>
        </div>
      </div>

      <div id="queue-filter-panel" class="glass-panel p-3 mb-5 flex flex-wrap items-center gap-2 rounded-2xl">
        <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 mr-2"><i class="fa-solid fa-filter text-[10px] mr-1"></i> Queue Filter:</span>
        <button onclick="toggleOwnerFilter('all')" id="tab-all" class="px-4 py-1.5 text-xs font-semibold rounded-full bg-blue-600 text-white shadow-sm focus:outline-none transition border border-transparent">All Calendars</button>
        <button onclick="toggleOwnerFilter('opskyc')" id="tab-opskyc" class="px-4 py-1.5 text-xs font-semibold rounded-full border border-blue-200 text-blue-600 hover:bg-blue-50 dark:border-blue-800 dark:text-blue-400 dark:hover:bg-blue-900 focus:outline-none transition">opskyc (KYC Risk)</button>
        <button onclick="toggleOwnerFilter('operationkyc')" id="tab-operationkyc" class="px-4 py-1.5 text-xs font-semibold rounded-full border border-orange-200 text-orange-600 hover:bg-orange-50 dark:border-orange-800 dark:text-orange-400 dark:hover:bg-orange-900 focus:outline-none transition">operationkyc (KYC)</button>
        <button onclick="toggleOwnerFilter('verification-kyc')" id="tab-verification-kyc" class="px-4 py-1.5 text-xs font-semibold rounded-full border border-purple-200 text-purple-600 hover:bg-purple-50 dark:border-purple-800 dark:text-purple-400 dark:hover:bg-purple-900 focus:outline-none transition">verification-kyc (Mule)</button>
        <button onclick="toggleOwnerFilter('opsverification')" id="tab-opsverification" class="px-4 py-1.5 text-xs font-semibold rounded-full border border-teal-200 text-teal-600 hover:bg-teal-50 dark:border-teal-800 dark:text-teal-400 dark:hover:bg-teal-900 focus:outline-none transition">opsverification (OPS)</button>
        <button onclick="toggleOwnerFilter('opsmule')" id="tab-opsmule" class="px-4 py-1.5 text-xs font-semibold rounded-full border border-stone-200 text-stone-600 hover:bg-stone-50 dark:border-stone-800 dark:text-stone-400 dark:hover:bg-stone-900 focus:outline-none transition">opsmule (OPS Mule)</button>
        <span class="ml-auto text-xs font-semibold text-blue-700 bg-blue-50 dark:bg-blue-900/20 dark:text-blue-400 px-3 py-1 rounded-full border border-blue-100 dark:border-blue-800/50" id="record-count-badge">0 records</span>
      </div>

      <div id="daily-kpi-panel" class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-5" style="display: grid;">
        <div class="glass-panel p-5 rounded-2xl">
          <div class="flex justify-between items-center mb-4">
            <span class="text-[11px] font-semibold text-gray-500 uppercase tracking-wide">1. Root-Cause (EDD Type)</span>
            <span class="text-[11px] bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-400 px-2.5 py-1 rounded-lg font-semibold border border-purple-200 dark:border-purple-800" id="insight-total-cases">0 Cases</span>
          </div>
          <div class="space-y-3 overflow-y-auto max-h-40 pr-1 text-sm" id="edd-type-chart-container"></div>
        </div>

        <div class="glass-panel p-5 rounded-2xl">
          <div class="flex justify-between items-center mb-4">
            <span class="text-[11px] font-semibold text-gray-500 uppercase tracking-wide">2. Team Workload Split</span>
            <span class="text-[11px] text-blue-500 font-semibold uppercase tracking-wide">Utilization %</span>
          </div>
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-sm font-medium mb-1.5"><span>opskyc (KYC Risk)</span><span id="txt-u-opskyc" class="font-semibold text-gray-400">0%</span></div>
              <div class="w-full bg-gray-200 dark:bg-gray-800 h-2 rounded-full overflow-hidden"><div id="bar-u-opskyc" class="bar-opskyc h-full range-bar" style="width:0%"></div></div>
            </div>
            <div>
              <div class="flex justify-between text-sm font-medium mb-1.5"><span>operationkyc (KYC)</span><span id="txt-u-oper" class="font-semibold text-gray-400">0%</span></div>
              <div class="w-full bg-gray-200 dark:bg-gray-800 h-2 rounded-full overflow-hidden"><div id="bar-u-oper" class="bar-oper h-full range-bar" style="width:0%"></div></div>
            </div>
            <div>
              <div class="flex justify-between text-sm font-medium mb-1.5"><span>verification-kyc (Mule)</span><span id="txt-u-vkyc" class="font-semibold text-gray-400">0%</span></div>
              <div class="w-full bg-gray-200 dark:bg-gray-800 h-2 rounded-full overflow-hidden"><div id="bar-u-vkyc" class="bar-vkyc h-full range-bar" style="width:0%"></div></div>
            </div>
            <div>
              <div class="flex justify-between text-sm font-medium mb-1.5"><span>opsverification (OPS)</span><span id="txt-u-over" class="font-semibold text-gray-400">0%</span></div>
              <div class="w-full bg-gray-200 dark:bg-gray-800 h-2 rounded-full overflow-hidden"><div id="bar-u-over" class="bar-over h-full range-bar" style="width:0%"></div></div>
            </div>
            <div>
              <div class="flex justify-between text-sm font-medium mb-1.5"><span>opsmule (OPS Mule)</span><span id="txt-u-opsmule" class="font-semibold text-gray-400">0%</span></div>
              <div class="w-full bg-gray-200 dark:bg-gray-800 h-2 rounded-full overflow-hidden"><div id="bar-u-opsmule" class="bar-opsmule h-full range-bar" style="width:0%"></div></div>
            </div>
          </div>
        </div>

        <div class="glass-panel p-5 flex flex-col justify-between rounded-2xl">
          <div class="flex justify-between items-center mb-4">
            <span class="text-[11px] font-semibold text-green-600 dark:text-green-500 uppercase tracking-wide">3. Live Quality Metrics</span>
            <span class="text-[11px] text-green-600 dark:text-green-500 font-semibold uppercase tracking-wide" id="txt-done-percent">Done: 0%</span>
          </div>
          <div class="grid grid-cols-2 gap-3 mb-4">
            <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded-xl text-center border border-gray-100 dark:border-gray-700">
              <span class="text-[10px] font-medium text-gray-400 uppercase tracking-wider">Thai Volume</span>
              <h4 class="text-3xl font-light tracking-tight mt-1" id="insight-lang-th">0</h4>
            </div>
            <div class="bg-blue-50 dark:bg-blue-900 p-3 rounded-xl text-center border border-blue-100 dark:border-blue-800">
              <span class="text-[10px] font-medium text-blue-500 uppercase tracking-wider">Interpreter</span>
              <h4 class="text-3xl font-light tracking-tight text-blue-500 mt-1" id="insight-lang-en">0</h4>
            </div>
            <div class="bg-green-50 dark:bg-green-900 p-3 rounded-xl text-center border border-green-100 dark:border-green-800">
              <span class="text-[10px] font-medium text-green-600 uppercase tracking-wider">EDD Done</span>
              <h4 class="text-3xl font-light tracking-tight text-green-600 mt-1" id="kpi-done">0</h4>
            </div>
            <div class="bg-red-50 dark:bg-red-900 p-3 rounded-xl text-center border border-red-100 dark:border-red-800">
              <span class="text-[10px] font-medium text-red-500 uppercase tracking-wider">Not Done</span>
              <h4 class="text-3xl font-light tracking-tight text-red-500 mt-1" id="kpi-notdone">0</h4>
            </div>
          </div>
          <div class="bg-red-50 dark:bg-red-900 border border-red-100 dark:border-red-800 p-3 rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-clock text-red-500 text-sm sla-pulse"></i>
              <span class="text-sm font-semibold text-red-600">SLA Required:</span>
            </div>
            <span class="text-sm font-bold text-red-600 bg-white dark:bg-gray-900 border border-red-100 dark:border-red-800 px-3 py-1 rounded-lg" id="insight-sla-pending">0 Items</span>
          </div>
        </div>
      </div>

      <div id="range-stats-panel" class="glass-panel p-8 mb-5 rounded-2xl" style="display: none;">
        <h3 class="text-lg font-semibold mb-6 text-gray-700 dark:text-gray-300"><i class="fa-solid fa-chart-pie text-blue-500 mr-2"></i>Range Summary Analytics</h3>
        <div id="range-analytics-content" class="text-base text-gray-400 text-center py-8">Select date range and refresh</div>
      </div>

      <div id="main-table-panel" class="glass-panel overflow-hidden rounded-2xl">
        <div class="overflow-x-auto">
          <table class="w-full table-fixed text-left min-w-[950px]">
            <thead>
              <tr>
                <th class="p-4" style="width: 12%;">Date / Time</th>
                <th class="p-4" style="width: 22%;">
                  <div class="flex items-center justify-between">
                    <span>UID / Customer Info</span>
                    <button onclick="toggleEmailMasking()" class="text-gray-400 hover:text-blue-500 transition" title="Toggle Privacy Masking"><i id="mask-icon" class="fa-solid fa-eye-slash"></i></button>
                  </div>
                </th>
                <th class="p-4" style="width: 20%;">Type / Status</th>
                <th class="p-4" style="width: 14%;">Meeting / Owner</th>
                <th class="p-4" style="width: 12%;">Officer</th>
                <th class="p-4" style="width: 12%;">Note Update</th>
                <th class="p-4 text-center" style="width: 8%;">Actions</th>
              </tr>
            </thead>
            <tbody id="tableBody" class="text-sm">
              <tr>
                <td colspan="7" class="p-16 text-center text-gray-400">
                  <i class="fa-solid fa-spinner fa-spin text-3xl mb-4 text-blue-500 block"></i>
                  <p class="text-base font-medium">Loading live secure records Matrix...</p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div id="admin-view" class="hidden">
        <div class="max-w-4xl mx-auto glass-panel p-8 rounded-2xl">
          <div class="border-b border-gray-200 dark:border-gray-800 pb-4 mb-6">
