    function toggleInlineAuditLogTray(eventId, owner) {
      const row = document.getElementById(`audit-row-${eventId}`);
      const container = document.getElementById(`audit-content-${eventId}`);
      
      if (!row.classList.contains('hidden')) { 
        row.classList.add('hidden'); 
        return; 
      }
      row.classList.remove('hidden'); 
      container.innerHTML = '<div class="text-sm text-gray-400 py-4 inline-flex items-center gap-2"><i class="fa-solid fa-spinner fa-spin text-blue-500"></i>Streaming history track...</div>';
      
      google.script.run.withSuccessHandler(function(res) {
        if (!res.success || res.logs.length === 0) { 
          container.innerHTML = '<div class="text-sm text-gray-400 py-3 inline-flex items-center gap-2"><i class="fa-solid fa-inbox opacity-50"></i>No modifications logged.</div>'; 
          return; 
        }
        
        let htmlLog = '<div class="mt-4 pl-1">';
        htmlLog += res.logs.map(function(log, idx) {
          let parts = log.timestamp.split(' by ');
          let dtStr = parts[0];
          let authorStr = parts.length > 1 ? parts[1] : 'System';
          
          let detailLines = log.detail.split('\n').map(line => {
            let cleaned = line.replace(/^\s*[•\-]\s*/, '').trim();
            if(cleaned) return `<li class="ml-5 list-disc marker:text-gray-400 text-xs text-gray-700 dark:text-gray-300 py-0.5 leading-relaxed">${cleaned}</li>`;
            return '';
          }).join('');

          let isLast = idx === res.logs.length - 1;
          
          return `
            <div class="flex gap-4">
              <div class="flex flex-col items-center">
                <div class="w-3 h-3 bg-blue-500 rounded-full shadow-sm ring-4 ring-gray-50 dark:ring-[#1C1C1E] mt-1.5 flex-shrink-0"></div>
                ${!isLast ? '<div class="w-0.5 h-full bg-gray-200 dark:bg-gray-700 my-1.5"></div>' : ''}
              </div>
              <div class="pb-6 w-full">
                <div class="flex flex-wrap items-center gap-2 mb-2 -mt-0.5">
                  <span class="text-[13px] font-bold text-gray-900 dark:text-gray-100">${dtStr}</span>
                  <span class="text-[9px] font-bold text-gray-400 uppercase tracking-widest">BY</span>
                  <span class="bg-yellow-100 text-yellow-800 font-bold px-2 py-0.5 rounded-md text-[10px] shadow-sm tracking-wide border border-yellow-200">${authorStr}</span>
                </div>
                <ul class="space-y-1 font-medium">
                  ${detailLines}
                </ul>
              </div>
            </div>
          `;
        }).join('');
        htmlLog += '</div>';
        container.innerHTML = htmlLog;
      }).getEventAuditLog(owner, eventId);
    }

